{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "vLLM serve (debugpy)",
            "type": "debugpy",
            "request": "launch",
            "module": "vllm.entrypoints.cli.main",
            "args": [
                "serve",
                "/home/lin/vllm_code/model/qwen3-0.6b",
                "--served-model-name", "qwen3-0.6b",
                "--enforce-eager",
                "--dtype", "float16",
                "--max-model-len", "4096",
                "--gpu-memory-utilization", "0.90",
                "--max-num-batched-tokens", "8192",
                "--max-num-seqs", "256",
                "--port", "13311"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/.vscode/debugpy:${env:PYTHONPATH}"
            }
        }
